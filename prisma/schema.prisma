generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model mst_contact_details {
  Id            Int        @id @default(autoincrement())
  ContactPerson String?    @db.VarChar(255)
  ContactNumber Int?
  trn_file      trn_file[]
}

model mst_document {
  Id       Int        @id @default(autoincrement())
  Document String?    @db.VarChar(255)
  trn_file trn_file[]
}

model mst_documenttype {
  Id           Int        @id @default(autoincrement())
  CreatedAt    DateTime?  @db.Timestamp(0)
  DocumentType String?    @db.VarChar(255)
  trn_file     trn_file[]
}

model mst_logbook {
  Id       Int        @id @default(autoincrement())
  Logbook  String?    @db.VarChar(255)
  trn_file trn_file[]
}

model mst_requesting_office {
  Id               Int        @id @default(autoincrement())
  RequestingOffice String?    @db.VarChar(255)
  trn_file         trn_file[]
}

model mst_spms {
  Id       Int        @id @default(autoincrement())
  Spms     String?    @db.VarChar(255)
  trn_file trn_file[]
}

model mst_status {
  Id       Int        @id @default(autoincrement())
  Status   String?    @db.VarChar(255)
  trn_file trn_file[]
}

model mst_user {
  Id       Int        @id @default(autoincrement())
  UserName String?    @db.VarChar(255)
  Password String?    @db.VarChar(255)
  trn_file trn_file[]
}

model trn_file {
  Id                    Int                    @id @default(autoincrement())
  DateTimeReceived      DateTime?              @db.Timestamp(0)
  DateCompleted         DateTime?              @db.Timestamp(0)
  DaysPending           Int?
  TitleSubjectPurpose   String?                @db.VarChar(255)
  ContactDetailId       Int?
  LogbookId             Int?
  DocumentId            Int?
  DocumentTypeId        Int?
  RequestingOfficeId    Int?
  ReviewedByUserId      Int?
  SpmsId                Int?
  StatusId              Int?
  ActionTaken           String?                @db.VarChar(255)
  DraftDocument         String?                @db.VarChar(255)
  FinalDocument         String?                @db.VarChar(255)
  ProofOfService        String?                @db.VarChar(255)
  mst_contact_details   mst_contact_details?   @relation(fields: [ContactDetailId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "trn_file_ibfk_1")
  mst_logbook           mst_logbook?           @relation(fields: [LogbookId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "trn_file_ibfk_2")
  mst_document          mst_document?          @relation(fields: [DocumentId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "trn_file_ibfk_3")
  mst_documenttype      mst_documenttype?      @relation(fields: [DocumentTypeId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "trn_file_ibfk_4")
  mst_requesting_office mst_requesting_office? @relation(fields: [RequestingOfficeId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "trn_file_ibfk_5")
  mst_user              mst_user?              @relation(fields: [ReviewedByUserId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "trn_file_ibfk_6")
  mst_spms              mst_spms?              @relation(fields: [SpmsId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "trn_file_ibfk_7")
  mst_status            mst_status?            @relation(fields: [StatusId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "trn_file_ibfk_8")

  @@index([ContactDetailId], map: "ContactDetailId")
  @@index([DocumentId], map: "DocumentId")
  @@index([DocumentTypeId], map: "DocumentTypeId")
  @@index([LogbookId], map: "LogbookId")
  @@index([RequestingOfficeId], map: "RequestingOfficeId")
  @@index([ReviewedByUserId], map: "ReviewedByUserId")
  @@index([SpmsId], map: "SpmsId")
  @@index([StatusId], map: "StatusId")
}
